#!/usr/bin/env bash
# ============================================================
# SpecRocket CLI — init / update / migrate
# 规格驱动开发（SDD）框架的命令入口
# Usage:
#   ./spec-rocket init [项目名]    # 初始化新项目（兼容 init.sh）
#   ./spec-rocket update          # 一键更新本地 skill（工具感知）
#   ./spec-rocket migrate [路径]   # 旧版项目迁移到最新模板结构（不符合模板文件：先收敛 docs，否则收敛 assets）
#   ./spec-rocket help            # 帮助
# ============================================================
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VERSION="2.10.0"
TEMPLATE="$SCRIPT_DIR/template"
GH_REPO="https://github.com/Toketec/SpecRocket.git"

# ---------- 颜色 ----------
C_GREEN='\033[0;32m'; C_YELLOW='\033[1;33m'; C_RED='\033[0;31m'; C_CYAN='\033[0;36m'; C_NC='\033[0m'
info()  { echo -e "${C_CYAN}[SpecRocket]${C_NC} $*"; }
ok()    { echo -e "${C_GREEN}✅ $*${C_NC}"; }
warn()  { echo -e "${C_YELLOW}⚠️  $*${C_NC}"; }
err()   { echo -e "${C_RED}❌ $*${C_NC}" >&2; }

# ============================================================
# init — 初始化新项目（逻辑与 init.sh 一致）
# ============================================================
cmd_init() {
  if [ ! -d "$TEMPLATE" ]; then
    err "找不到 template/ 目录。请先 clone 本仓库：git clone $GH_REPO"
    exit 1
  fi
  if [ $# -eq 0 ]; then
    TARGET_DIR="."
    info "在当前目录初始化骨架 ... ($(pwd))"
  else
    NAME="$1"
    TARGET_DIR="${2:-$NAME}"
    if [ -d "$TARGET_DIR" ]; then
      err "目录 '$TARGET_DIR' 已存在"
      exit 1
    fi
    info "创建 $TARGET_DIR ..."
    mkdir -p "$TARGET_DIR"
  fi
  info "复制骨架 ..."
  shopt -s dotglob
  cp -r "$TEMPLATE"/* "$TARGET_DIR/"
  shopt -u dotglob
  cd "$TARGET_DIR"
  if [ ! -d .git ]; then
    info "初始化 Git ..."
    git init >/dev/null
    git add . >/dev/null
    git commit -m "init: SpecRocket project skeleton" >/dev/null 2>&1 || warn "git commit 失败（可能未配置用户信息），可稍后手动提交"
  fi
  ok "项目已初始化"
  echo "  下一步：运行 /spec-rocket brainstorm 引导写产品文档"
}

# ============================================================
# update — 一键更新本地 skill（工具感知）
# ============================================================
cmd_update() {
  info "SpecRocket update v$VERSION — 检测本地安装的 AI 工具并同步 skill ..."
  echo ""

  # ① 更新本地仓库（保证模板源头最新）
  if git rev-parse --git-dir >/dev/null 2>&1 && git remote get-url origin 2>/dev/null | grep -qi specrocket; then
    info "① 更新本地 SpecRocket 仓库 (git pull) ..."
    git pull --ff-only 2>&1 | sed 's/^/    /' || warn "git pull 失败，跳过（可稍后手动 git pull）"
  else
    warn "① 当前不在 SpecRocket 仓库内，跳过仓库更新"
  fi
  echo ""

  # ② 检测 AI 工具
  info "② 检测 AI 工具 ..."
  FOUND=()
  for tool in hermes claude codex cursor windsurf cline aider; do
    if command -v "$tool" >/dev/null 2>&1; then
      FOUND+=("$tool")
      echo "    已检测: $tool"
    fi
  done
  # 无 CLI 命令但存在配置目录也算
  [ -d "$HOME/.hermes" ] && echo "    已检测: Hermes Agent (~/.hermes)"
  [ -d "$HOME/.claude" ] && echo "    已检测: Claude Code (~/.claude)"
  [ -d "$HOME/.codex" ] && echo "    已检测: Codex (~/.codex)"
  [ -d "$HOME/.cursor" ] && echo "    已检测: Cursor (~/.cursor)"
  [ -d "$HOME/.windsurf" ] && echo "    已检测: Windsurf (~/.windsurf)"
  if [ ${#FOUND[@]} -eq 0 ]; then
    warn "未检测到常见 AI 工具 CLI。仍将同步 Hermes skill 目录（若存在）。"
  fi
  echo ""

  # ③ 按工具同步 skill / 规则文件
  info "③ 按工具同步 skill ..."

  # Hermes Agent → ~/.hermes/skills/spec-rocket/
  if [ -d "$HOME/.hermes/skills" ]; then
    SYNC_HERMES=1
    if [ ! -f "$SCRIPT_DIR/SKILL.md" ]; then
      err "仓库内缺少 SKILL.md，无法同步 Hermes skill"
      SYNC_HERMES=0
    fi
    if [ "$SYNC_HERMES" = "1" ]; then
      mkdir -p "$HOME/.hermes/skills/spec-rocket"
      cp "$SCRIPT_DIR/SKILL.md" "$HOME/.hermes/skills/spec-rocket/SKILL.md"
      [ -d "$SCRIPT_DIR/references" ] && { mkdir -p "$HOME/.hermes/skills/spec-rocket/references"; cp -r "$SCRIPT_DIR/references"/* "$HOME/.hermes/skills/spec-rocket/references/" 2>/dev/null || true; }
      ok "Hermes skill 已同步 → ~/.hermes/skills/spec-rocket/ (v$VERSION)"
    fi
  else
    info "    未发现 ~/.hermes/skills，跳过 Hermes 同步"
  fi

  # spec-rocket-light（若本地存在）
  if [ -d "$HOME/.hermes/skills/spec-rocket-light" ]; then
    LIGHT_SYNCED=0
    for light_src in "$SCRIPT_DIR/../SpecRocket-light/SKILL.md" "$SCRIPT_DIR/../SpecRocketLight/SKILL.md"; do
      if [ -f "$light_src" ]; then
        cp "$light_src" "$HOME/.hermes/skills/spec-rocket-light/SKILL.md"
        ok "spec-rocket-light skill 已同步 (来自 $light_src)"
        LIGHT_SYNCED=1
        break
      fi
    done
    [ "$LIGHT_SYNCED" = "0" ] && warn "本地有 spec-rocket-light skill，但未找到 light 源仓库（SpecRocketLight/），跳过"
  else
    info "    spec-rocket-light 未安装，跳过"
  fi

  # Codex → ~/.codex/AGENTS.md（全局指令，谨慎：只更新已有 SpecRocket 片段，不强制写入）
  if [ -f "$HOME/.codex/AGENTS.md" ] && grep -q "SpecRocket" "$HOME/.codex/AGENTS.md" 2>/dev/null; then
    warn "检测到 ~/.codex/AGENTS.md 含 SpecRocket 内容——请手动更新该文件中的版本说明，或删除旧片段后由项目级 AGENTS.md 接管"
  else
    info "    Codex: 未发现全局 SpecRocket 配置（推荐用项目级 AGENTS.md，由 init/migrate 注入）"
  fi

  # Claude Code / Cursor / Windsurf / Cline → 项目级规则文件
  info "    Claude Code / Cursor / Windsurf / Cline: 规则文件在项目内（CLAUDE.md / .cursorrules / .windsurf/rules），"
  info "    由每个项目的 /spec-rocket migrate 或 init 注入最新版本，无需全局更新。"

  echo ""
  ok "update 完成"
  echo "  版本: v$VERSION  |  变更摘要见 GitHub Release 或 README"
  echo "  若本项目使用的模板已过时，请对项目执行 /spec-rocket migrate 升级结构"
}

# ============================================================
# migrate — 旧版项目迁移到最新模板结构（结构层）
# 内容层（拆分/转移语义内容）由 AI 斜杠命令按 SKILL.md 规则执行
# ============================================================
cmd_migrate() {
  TARGET="${1:-.}"
  if [ ! -d "$TARGET" ]; then
    err "目标目录不存在: $TARGET"
    exit 1
  fi
  cd "$TARGET"
  info "SpecRocket migrate — 目标: $(pwd)"
  echo ""

  # 检测旧版文件（v2.1 ~ v2.3）
  LEGACY_FILES=()
  FOUND_LEGACY=0

  # 旧 sprint 文件
  while IFS= read -r f; do
    LEGACY_FILES+=("$f")
    FOUND_LEGACY=1
  done < <(find docs -name "ux-flows.md" -o -name "ui-wireframes.md" -o -name "user-journey-flows.md" 2>/dev/null || true)

  # 全局 spec/ 目录或 _catalog.yaml（v2.1 前）
  if [ -d spec ] || [ -f _catalog.yaml ] || [ -f specs/_catalog.yaml ]; then
    LEGACY_FILES+=("[全局] spec/ 目录 或 _catalog.yaml")
    FOUND_LEGACY=1
  fi

  # 废弃 sprint-000_initial 目录（v2.5.0 起 sprints 只保留 _template/，000 由 brainstorm 直接创建 sprint-001）
  if [ -d docs/sprints/sprint-000_initial ]; then
    # 检测是否含真实内容：所有 .md 仍含 {占位符} = 纯模板副本 → 直接删除；否则保留为 .legacy
    HAS_REAL=$(grep -L "{" docs/sprints/sprint-000_initial/*.md 2>/dev/null | head -1)
    if [ -z "$HAS_REAL" ]; then
      rm -rf docs/sprints/sprint-000_initial
      ok "已删除废弃目录: docs/sprints/sprint-000_initial/（纯模板副本，无真实内容）"
    else
      mv docs/sprints/sprint-000_initial docs/sprints/sprint-000_initial.legacy
      warn "sprint-000_initial 含真实内容 → 已保留为 sprint-000_initial.legacy/（AI 转移内容后删除）"
      LEGACY_FILES+=("[目录] docs/sprints/sprint-000_initial/ → .legacy/")
      FOUND_LEGACY=1
    fi
  fi

  # 清理文档中的 sprint-000_initial 结构图残留（v2.8.0）
  # 老项目从旧模板复制的 AGENTS.md/README.md 等，结构图仍画着 sprint-000_initial，
  # 与实际目录（已删除/legacy）不统一 → 自动删除结构图中的 000 块，修正兄弟项前缀
  DOC_000_FIXED=0
  DOC_000_NOTE=()
  for doc in AGENTS.md CLAUDE.md README.md README.en.md ssot-convention*.md docs/README.md; do
    [ -f "$doc" ] || continue
    case "$doc" in *.legacy.md) continue;; esac
    if grep -q "sprint-000" "$doc" 2>/dev/null; then
      # awk：删结构图中的 000 块；000 是最后兄弟时把前一个兄弟 ├── 改为 └──
      # 注意：不用字符类 [├└] 等（gawk C locale 下多字节字符类不可靠），统一用 index() 字节匹配
      awk '
        function emit_pending() {
          if (pending != "") {
            if (fix_next && index(pending, "├──") > 0) sub(/├──/, "└──", pending)
            print pending
            pending = ""
          }
          fix_next = 0
        }
        index($0, "sprint-000_initial") > 0 && (index($0, "├──") > 0 || index($0, "└──") > 0) {
          if (index($0, "└──") > 0) fix_next = 1
          removed++
          in000 = 1
          next
        }
        in000 {
          p1 = index($0, "│")
          if (p1 > 0 && index(substr($0, p1 + 1), "│") > 0) { removed++; next }
          if ($0 ~ /^[[:space:]]*$/) { removed++; next }
          in000 = 0
        }
        index($0, "├──") > 0 || index($0, "└──") > 0 {
          emit_pending()
          pending = $0
          next
        }
        { emit_pending(); print }
        END { emit_pending(); if (removed > 0) print removed > "/dev/stderr" }
      ' "$doc" > "${doc}.sr000" 2>/tmp/sr000_stat
      REMOVED=$(cat /tmp/sr000_stat 2>/dev/null)
      if [ -s "${doc}.sr000" ] && [ "${REMOVED:-0}" -gt 0 ] 2>/dev/null; then
        mv "${doc}.sr000" "$doc"
        DOC_000_FIXED=1
        ok "已清理 $doc 中 sprint-000_initial 结构图残留（删除 ${REMOVED} 行）"
      else
        rm -f "${doc}.sr000"
      fi
      # 正文描述残留（非结构图）→ 记录待 AI 处理
      BODY_HITS=$(grep -n "sprint-000" "$doc" 2>/dev/null | grep -v '[├└]──' | head -5 || true)
      if [ -n "$BODY_HITS" ]; then
        DOC_000_NOTE+=("$doc: $BODY_HITS")
      fi
    fi
  done
  if [ "$DOC_000_FIXED" = "1" ]; then
    warn "已自动清理文档中的 sprint-000_initial 结构图残留（目录与文档保持一致）"
  fi

  # 项目根残留 ssot-convention（方法论本体文档，仅应存在于 SpecRocket 主仓库）
  if ls ssot-convention*.md >/dev/null 2>&1; then
    mkdir -p archive
    for f in ssot-convention*.md; do
      mv "$f" "archive/$f"
      ok "已归档: $f → archive/$f（方法论本体文档，最新版见 SpecRocket GitHub 主仓库）"
    done
  fi

  # 补齐 assets/ 运营资产骨架（v2.9.0）
  # assets/ = 被系统/业务直接引用的工程资产（配置模板/对外接口/规范库/手册），由 Ops 角色产出
  if [ ! -d assets ]; then
    if [ -d "$SCRIPT_DIR/template/assets" ]; then
      cp -r "$SCRIPT_DIR/template/assets" assets
      ok "已创建 assets/ 运营资产骨架（configs/interfaces/standards/manuals，详见 assets/README.md）"
    fi
  fi
  # 不符合模板文件的两级收敛策略（v2.10.0）
  # 规则1: 优先收敛到 docs/ 设计相关文档（内容型 .md，由 AI 语义合并）
  # 规则2: 相关性不大或无法收敛 → 转移并收敛到 assets/ 对应子目录（资产型）
  # ── 规则2：运营资产目录自动转移归位（config/api/manual/standards → assets/ 对应子类）
  OPS_MOVED=0
  OPS_CONFLICT=()
  move_ops_dir() { # $1=源目录 $2=目标子目录 $3=说明
    local src="$1" dst="assets/$2"
    [ -d "$src" ] || return 0
    if [ ! -d "$dst" ]; then
      mv "$src" "$dst"
      ok "已转移: $src/ → $dst/（规则2：运营资产收敛 assets/）"
      OPS_MOVED=1
    elif [ -z "$(ls -A "$dst" | grep -v '^\.gitkeep$' 2>/dev/null)" ]; then
      # 目标为空骨架（仅 .gitkeep）→ 合并转移
      mv "$src"/* "$dst"/ 2>/dev/null || true
      rmdir "$src" 2>/dev/null || true
      ok "已转移: $src/ → $dst/（规则2：运营资产收敛 assets/，合并入骨架）"
      OPS_MOVED=1
    else
      OPS_CONFLICT+=("$src/ → $dst/（目标已存在，内容请 AI 合并）")
    fi
  }
  move_ops_dir config configs "配置模板"
  move_ops_dir api interfaces "对外接口"
  move_ops_dir manual manuals "说明手册"
  move_ops_dir docs-manual manuals "说明手册"
  move_ops_dir standards standards "规范库"
  if [ "${#OPS_CONFLICT[@]}" -gt 0 ]; then
    for c in "${OPS_CONFLICT[@]}"; do
      warn "目标已存在，跳过自动转移: $c"
    done
  fi
  # ── 规则1：游离内容文档扫描（docs/ 散落 .md + 根目录非白名单 .md）→ 收敛到 docs 对应文档
  # docs/ 模板只允许 product-overview / non-functional-reqs / visual-design / sprints/（及 preview.html）
  is_legacy_file() { # $1=路径，判断是否已识别为旧版文件
    local f="$1"
    for lf in "${LEGACY_FILES[@]}"; do
      case "$lf" in \[全局\]*) continue;; esac
      [ "$f" = "$lf" ] && return 0
    done
    return 1
  }
  STRAY_DOCS=()
  if [ -d docs ]; then
    while IFS= read -r f; do
      base=$(basename "$f")
      case "$base" in
        product-overview.md|non-functional-reqs.md|visual-design.md|README.md) continue ;;
        *.legacy.md) continue ;;
      esac
      is_legacy_file "$f" && continue
      STRAY_DOCS+=("$f")
    done < <(find docs -maxdepth 1 -type f -name "*.md" 2>/dev/null || true)
  fi
  # 根目录非白名单 .md（排除模板文件/方法论本体/迁移报告）
  while IFS= read -r f; do
    base=$(basename "$f")
    case "$base" in
      AGENTS.md|CLAUDE.md|README.md|README.en.md|MIGRATION-REPORT.md|ssot-convention*.md|LICENSE) continue ;;
      *.legacy.md) continue ;;
    esac
    is_legacy_file "${f#./}" && continue
    STRAY_DOCS+=("$f")
  done < <(find . -maxdepth 1 -type f -name "*.md" 2>/dev/null || true)
  if [ "${#STRAY_DOCS[@]}" -gt 0 ]; then
    warn "检测到不符合模板的游离文档（规则1：优先收敛到 docs/ 设计相关文档，由 AI 判断内容归属并合并）："
    for f in "${STRAY_DOCS[@]}"; do
      echo "    - $f"
    done
  fi

  if [ "$FOUND_LEGACY" = "0" ]; then
    ok "未检测到旧版文件，项目结构已是最新"
  else
    warn "检测到以下旧版文件，需要迁移："
    for f in "${LEGACY_FILES[@]}"; do
      echo "    - $f"
    done
    echo ""
  fi

  # 从模板补齐缺失的新 sprint 文件
  if [ -d docs/sprints ]; then
    info "从模板补齐缺失的 sprint 文件 ..."
    SPRINT_DIRS=$(find docs/sprints -mindepth 1 -maxdepth 1 -type d ! -name "_template" 2>/dev/null || true)
    if [ -z "$SPRINT_DIRS" ]; then
      info "    无具体 sprint 目录（或只有 _template），跳过补齐"
    fi
    for sprint in $SPRINT_DIRS; do
      for f in user-scenarios.md business-flows.md uml-pack.md; do
        if [ ! -f "$sprint/$f" ] && [ -f "$SCRIPT_DIR/template/docs/sprints/_template/$f" ]; then
          cp "$SCRIPT_DIR/template/docs/sprints/_template/$f" "$sprint/$f"
          ok "    补齐: $sprint/$f"
        fi
      done
    done
  fi

  # 旧文件重命名保留（内容留给 AI 转移），并生成迁移报告
  # 报告生成条件：有旧版文件 或 有规则2已转移资产 或 有规则1游离文档
  REPORT_NEEDED=$FOUND_LEGACY
  [ "$OPS_MOVED" = "1" ] && REPORT_NEEDED=1
  [ "${#OPS_CONFLICT[@]}" -gt 0 ] && REPORT_NEEDED=1
  [ "${#STRAY_DOCS[@]}" -gt 0 ] && REPORT_NEEDED=1
  if [ "$REPORT_NEEDED" = "1" ]; then
    REPORT="MIGRATION-REPORT.md"
    {
      echo "# 迁移报告 — $(date +%Y-%m-%d)"
      echo ""
      echo "> 由 /spec-rocket migrate 生成。以下旧版文件已重命名为 *.legacy.md 保留内容，"
      echo "> 请由 AI 按 SKILL.md 的迁移规则将内容转移到新模板文件，完成后删除 *.legacy.md。"
      echo ""
      echo "## 迁移规则速查"
      echo ""
      echo "| 旧文件 | 内容去向 |"
      echo "|:-------|:---------|"
      echo "| \`ux-flows.md\` | 旅程部分 → \`user-scenarios.md\`；流程部分 → \`business-flows.md\` |"
      echo "| \`ui-wireframes.md\` | 布局/交互 → \`prototypes/\` 原型；系统图表 → \`uml-pack.md\` |"
      echo "| \`user-journey-flows.md\` | 旅程总览 → \`user-scenarios.md\`；流程图 → \`business-flows.md\` |"
      echo "| \`sprint-000_initial/\` | v2.5.0 已废弃（纯模板副本直接删；含真实内容 → 转移基线设计到 \`sprint-001/\` 后删 .legacy） |"
      echo "| 全局 \`spec/\` + \`_catalog.yaml\` | 迁移到 \`{apps|businesses|tools}/*/specs/\` 四文件 |"
      echo ""
      echo "## 不符合模板文件处理规则（v2.10.0）"
      echo ""
      echo "升级过程中遇到不符合项目模板的文件，按两级策略处理："
      echo ""
      echo "1. **规则1 — 优先收敛到 docs/ 设计相关文档**：内容型文档（需求/设计/说明类 .md）由 AI 判断内容归属，合并进 \`docs/\` 对应文档（product-overview / non-functional-reqs / visual-design / sprints/ 等）"
      echo "2. **规则2 — 转移并收敛到 assets/**：相关性不大或无法收敛的资产型文件（配置/接口/手册/规范），转移到 \`assets/\` 对应子目录（configs / interfaces / standards / manuals）"
      echo ""
      echo "> 已在本次迁移中自动执行的规则2转移见下方「已转移资产」；未自动转移的冲突项由 AI 手动合并。"
      echo ""
      echo "## 待迁移文件"
      echo ""
    } > "$REPORT"
    for f in "${LEGACY_FILES[@]}"; do
      if [[ "$f" != \[全局\]* ]] && [ -f "$f" ]; then
        mv "$f" "${f%.md}.legacy.md"
        echo "- \`$f\` → 内容转移到新文件后删除" >> "$REPORT"
      else
        echo "- $f（目录/文件，请 AI 处理）" >> "$REPORT"
      fi
    done
    # 追加规则2：已转移资产
    if [ "$OPS_MOVED" = "1" ] || [ "${#OPS_CONFLICT[@]}" -gt 0 ]; then
      echo "" >> "$REPORT"
      echo "## 已转移资产（规则2，脚本自动执行）" >> "$REPORT"
      echo "" >> "$REPORT"
      if [ "$OPS_MOVED" = "1" ]; then
        echo "- 运营资产目录已自动归位 \`assets/\` 对应子目录（configs / interfaces / standards / manuals）" >> "$REPORT"
      fi
      for c in "${OPS_CONFLICT[@]}"; do
        echo "- 冲突待合并: $c" >> "$REPORT"
      done
    fi
    # 追加规则1：游离文档（AI 收敛到 docs/）
    if [ "${#STRAY_DOCS[@]}" -gt 0 ]; then
      echo "" >> "$REPORT"
      echo "## 游离文档（规则1，AI 收敛到 docs/）" >> "$REPORT"
      echo "" >> "$REPORT"
      echo "以下文档不符合模板结构，由 AI 判断内容归属并合并到 docs/ 对应文档（product-overview / non-functional-reqs / visual-design / sprints/ 等），完成后删除原文件：" >> "$REPORT"
      for f in "${STRAY_DOCS[@]}"; do
        echo "- $f" >> "$REPORT"
      done
    fi
    ok "已生成迁移报告: $REPORT（旧文件保留为 *.legacy.md，待 AI 内容转移）"
  fi

  # 提示
  echo ""
  info "migrate 结构层完成。"
  if [ "$REPORT_NEEDED" = "1" ]; then
    echo "  1. 让 AI 读取 MIGRATION-REPORT.md"
    echo "  2. 按两级规则处理：规则1 游离文档 → 收敛到 docs/ 对应文档；规则2 已转移资产 → 确认归属"
    echo "  3. 旧版文件（*.legacy.md）内容转移后删除"
  else
    echo "  项目结构已是最新。下一步：运行 /spec-rocket brainstorm 引导写产品文档（或按需完善 assets/）"
  fi
}

# ============================================================
# main
# ============================================================
case "${1:-help}" in
  init)    shift; cmd_init "$@" ;;
  update)  shift; cmd_update "$@" ;;
  migrate) shift; cmd_migrate "$@" ;;
  help|-h|--help|"")
    echo "SpecRocket CLI v$VERSION"
    echo "Usage:"
    echo "  ./spec-rocket init [项目名]    # 初始化新项目（无参=当前目录）"
    echo "  ./spec-rocket update          # 一键更新本地 skill（自动检测 AI 工具）"
    echo "  ./spec-rocket migrate [路径]   # 旧版项目迁移（不符合模板文件：先收敛 docs，否则收敛 assets）"
    ;;
  *)
    err "未知命令: $1（可用: init / update / migrate / help）"
    exit 1
    ;;
esac
