#!/usr/bin/env bash
# ============================================================
# SpecRocket CLI — init / update / migrate
# 规格驱动开发（SDD）框架的命令入口 (v4.1.0)
# Usage:
#   ./spec-rocket init [项目名]    # 初始化新项目（兼容 init.sh）
#   ./spec-rocket update          # 一键更新本地 skill（工具感知）
#   ./spec-rocket migrate [路径]   # 项目重构：介入 → 理解 → 保持 → 重构（不区分是否 SpecRocket 项目）
#   ./spec-rocket help            # 帮助
# ============================================================
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VERSION="4.1.0"
TEMPLATE="$SCRIPT_DIR/template"
GH_REPO="https://github.com/Toketec/SpecRocket.git"
USER_BASE="${SPECROCKET_USER_HOME:-$HOME}"

# ---------- 颜色 ----------
C_GREEN='\033[0;32m'; C_YELLOW='\033[1;33m'; C_RED='\033[0;31m'; C_CYAN='\033[0;36m'; C_NC='\033[0m'
info()  { echo -e "${C_CYAN}[SpecRocket]${C_NC} $*"; }
ok()    { echo -e "${C_GREEN}✅ $*${C_NC}"; }
warn()  { echo -e "${C_YELLOW}⚠️  $*${C_NC}"; }
err()   { echo -e "${C_RED}❌ $*${C_NC}" >&2; }

# ============================================================
# init — 初始化新项目（逻辑与 init.sh 一致）
# ============================================================
cmd_init() {
  if [ ! -d "$TEMPLATE" ]; then
    err "找不到 template/ 目录。请先 clone 本仓库：git clone $GH_REPO"
    exit 1
  fi
  if [ $# -eq 0 ]; then
    TARGET_DIR="."
    info "在当前目录初始化骨架 ... ($(pwd))"
  else
    NAME="$1"
    TARGET_DIR="${2:-$NAME}"
    if [ -d "$TARGET_DIR" ]; then
      err "目录 '$TARGET_DIR' 已存在"
      exit 1
    fi
    info "创建 $TARGET_DIR ..."
    mkdir -p "$TARGET_DIR"
  fi
  info "复制骨架 ..."
  shopt -s dotglob
  cp -r "$TEMPLATE"/* "$TARGET_DIR/"
  shopt -u dotglob
  cd "$TARGET_DIR"
  if [ ! -d .git ]; then
    info "初始化 Git ..."
    git init >/dev/null
    git add . >/dev/null
    git commit -m "init: SpecRocket project skeleton" >/dev/null 2>&1 || warn "git commit 失败（可能未配置用户信息），可稍后手动提交"
  fi
  ok "项目已初始化（v$VERSION 结构：docs/ + architecture/ + sprints/ + apps/businesses/tools + assets/）"
  echo "  下一步：运行 /spec-rocket brainstorm 引导写产品文档"
}

# ============================================================
# update — 一键更新本地 skill（工具感知）
# ============================================================
cmd_update() {
  info "SpecRocket update v$VERSION — 检测本地安装的 AI 工具并同步 skill ..."
  echo ""

  # ① 更新本地仓库（保证模板源头最新）
  if [ "${SPECROCKET_OFFLINE:-0}" = "1" ]; then
    info "① 离线模式，跳过仓库更新"
  elif git rev-parse --git-dir >/dev/null 2>&1 && git remote get-url origin 2>/dev/null | grep -qi specrocket; then
    info "① 更新本地 SpecRocket 仓库 (git pull) ..."
    git pull --ff-only 2>&1 | sed 's/^/    /' || warn "git pull 失败，跳过（可稍后手动 git pull）"
  else
    warn "① 当前不在 SpecRocket 仓库内，跳过仓库更新"
  fi
  echo ""

  # ② 检测 AI 工具
  info "② 检测 AI 工具 ..."
  FOUND=()
  for tool in hermes claude codex cursor windsurf cline aider; do
    if command -v "$tool" >/dev/null 2>&1; then
      FOUND+=("$tool")
      echo "    已检测: $tool"
    fi
  done
  # 无 CLI 命令但存在配置目录也算
  [ -d "$USER_BASE/.hermes" ] && echo "    已检测: Hermes Agent ($USER_BASE/.hermes)"
  [ -d "$USER_BASE/.claude" ] && echo "    已检测: Claude Code ($USER_BASE/.claude)"
  [ -d "$USER_BASE/.codex" ] && echo "    已检测: Codex ($USER_BASE/.codex)"
  [ -d "$USER_BASE/.cursor" ] && echo "    已检测: Cursor ($USER_BASE/.cursor)"
  [ -d "$USER_BASE/.windsurf" ] && echo "    已检测: Windsurf ($USER_BASE/.windsurf)"
  if [ ${#FOUND[@]} -eq 0 ]; then
    warn "未检测到常见 AI 工具 CLI。仍将同步 Hermes skill 目录（若存在）。"
  fi
  echo ""

  # ③ 按工具同步 skill / 规则文件
  info "③ 按工具同步 skill ..."

  # Hermes Agent → ~/.hermes/skills/spec-rocket/
  if [ -d "$USER_BASE/.hermes/skills" ]; then
    SYNC_HERMES=1
    if [ ! -f "$SCRIPT_DIR/SKILL.md" ]; then
      err "仓库内缺少 SKILL.md，无法同步 Hermes skill"
      SYNC_HERMES=0
    fi
    if [ "$SYNC_HERMES" = "1" ]; then
      mkdir -p "$USER_BASE/.hermes/skills/spec-rocket"
      cp "$SCRIPT_DIR/SKILL.md" "$USER_BASE/.hermes/skills/spec-rocket/SKILL.md"
      ok "Hermes skill 已同步 → $USER_BASE/.hermes/skills/spec-rocket/ (v$VERSION)"
    fi
  else
    info "    未发现 ~/.hermes/skills，跳过 Hermes 同步"
  fi

  # spec-rocket-light（若本地存在）
  if [ -d "$USER_BASE/.hermes/skills/spec-rocket-light" ]; then
    LIGHT_SYNCED=0
    for light_src in "$SCRIPT_DIR/../SpecRocket-light/SKILL.md" "$SCRIPT_DIR/../SpecRocketLight/SKILL.md"; do
      if [ -f "$light_src" ]; then
        cp "$light_src" "$USER_BASE/.hermes/skills/spec-rocket-light/SKILL.md"
        ok "spec-rocket-light skill 已同步 (来自 $light_src)"
        LIGHT_SYNCED=1
        break
      fi
    done
    [ "$LIGHT_SYNCED" = "0" ] && warn "本地有 spec-rocket-light skill，但未找到 light 源仓库（SpecRocketLight/），跳过"
  else
    info "    spec-rocket-light 未安装，跳过"
  fi

  # Codex → ~/.codex/AGENTS.md（全局指令，谨慎：只更新已有 SpecRocket 片段，不强制写入）
  if [ -f "$USER_BASE/.codex/AGENTS.md" ] && grep -q "SpecRocket" "$USER_BASE/.codex/AGENTS.md" 2>/dev/null; then
    warn "检测到 ~/.codex/AGENTS.md 含 SpecRocket 内容——请手动更新该文件中的版本说明，或删除旧片段后由项目级 AGENTS.md 接管"
  else
    info "    Codex: 未发现全局 SpecRocket 配置（推荐用项目级 AGENTS.md，由 init/migrate 注入）"
  fi

  # Claude Code / Cursor / Windsurf / Cline → 项目级规则文件
  info "    Claude Code / Cursor / Windsurf / Cline: 规则文件在项目内（CLAUDE.md / .cursorrules / .windsurf/rules），"
  info "    由每个项目的 /spec-rocket migrate 或 init 注入最新版本，无需全局更新。"

  echo ""
  ok "update 完成"
  echo "  版本: v$VERSION  |  变更摘要见 GitHub Release 或 README"
  echo "  若本项目使用的模板已过时，请对项目执行 /spec-rocket migrate 重构"
}

# ============================================================
# migrate — 项目重构：介入 → 理解 → 保持 → 重构（结构层由脚本执行）
# 重构原则：转移 → 收敛 → 保留 → 删除；最终目录结构零残留
# 内容层（理解项目/转移语义内容/保持原有设计）由 AI 斜杠命令按 SKILL.md 规则执行
# ============================================================
cmd_migrate() {
  TARGET="${1:-.}"
  if [ ! -d "$TARGET" ]; then
    err "目标目录不存在: $TARGET"
    exit 1
  fi
  cd "$TARGET"
  info "SpecRocket migrate v$VERSION — 目标: $(pwd)"
  echo ""

  REPORT_NEEDED=0
  LEGACY_NOTES=()     # 保留待确认项（内容已转移，确认后删除）
  STRAY_DOCS=()       # 规则1：游离内容文档 → 收敛 docs/
  ROOT_STRAY_R1=()    # 规则1：根目录内容型文档 → 收敛 docs/
  ROOT_STRAY_R2=()    # 规则2：根目录非规范项 → 归位 assets/
  ASSETS_STRAY=()
  ARCHITECTURE_STRAY=() # architecture/ 根目录除三份当前文档外的内容，需 AI 收敛
  ARCHITECTURE_SOURCES=() # 当前架构收敛证据：每项都必须在报告中完成分类和去向映射
  LEGACY_SPECS=()     # 旧 spec 缺少架构落地边界，由 AI 补齐语义

  # ═══════════════════════════════════════════════
  # 1. 迁移旧 sprint 容器：docs/sprints/sprint-NNN_xxx/ → sprints/sp-NNN-xxx/docs/
  # ═══════════════════════════════════════════════
  if [ -d docs/sprints ]; then
    info "① 检测到旧结构 docs/sprints/，迁移到顶层 sprints/ ..."
    mkdir -p sprints

    # 旧 sprint 文件（v2.1 ~ v2.3）检测
    while IFS= read -r f; do
      LEGACY_NOTES+=("$f（旧版文件，AI 按迁移映射表转移内容）")
      REPORT_NEEDED=1
    done < <(find docs -name "ux-flows.md" -o -name "ui-wireframes.md" -o -name "user-journey-flows.md" 2>/dev/null || true)

    # 处理具体 sprint：sprint-NNN_xxx/ → sp-NNN-xxx/docs/
    for sprint in docs/sprints/sprint-*; do
      [ -d "$sprint" ] || continue
      base=$(basename "$sprint")
      [ "$base" = "sprint-000_initial" ] && continue
      case "$base" in *.legacy) continue;; esac
      newname=$(printf '%s' "$base" | sed 's/^sprint-/sp-/; s/_/-/g')
      if [ -d "sprints/$newname" ]; then
        legacy="$sprint.legacy"
        if [ ! -e "$legacy" ]; then
          mv "$sprint" "$legacy"
          warn "    目标 sprints/$newname 已存在，旧内容完整保留为 $legacy"
          LEGACY_NOTES+=("$legacy → 与 sprints/$newname/ 对比合并，确认无遗漏后删除")
        else
          warn "    目标 sprints/$newname 与 $legacy 均已存在，保留 $sprint 待 AI 对比"
          LEGACY_NOTES+=("$sprint、$legacy 与 sprints/$newname/ 存在冲突，AI 对比合并")
        fi
        REPORT_NEEDED=1
        continue
      fi
      mkdir -p "sprints/$newname/docs"
      # 转移产品文档；specs 单独进入新容器，禁止复制到 docs/ 下形成重复来源
      for entry in "$sprint"/*; do
        [ -e "$entry" ] || continue
        [ "$(basename "$entry")" = "specs" ] && continue
        cp -r "$entry" "sprints/$newname/docs/"
      done
      # sprint 内含 specs/ 的情况（v2.12 结构异常）→ 移到新 specs/
      if [ -d "$sprint/specs" ]; then
        cp -r "$sprint/specs" "sprints/$newname/specs" 2>/dev/null || true
      fi
      ok "    已转移: $base → sprints/$newname/docs/"
      mv "$sprint" "$sprint.legacy"
      LEGACY_NOTES+=("$sprint.legacy → 内容已转移至 sprints/$newname/，AI 确认后删除")
      REPORT_NEEDED=1
    done

    # 处理 sprint-000（v2.5 废弃）
    if [ -d docs/sprints/sprint-000_initial ]; then
      HAS_REAL=$(grep -L "{" docs/sprints/sprint-000_initial/*.md 2>/dev/null | head -1)
      if [ -z "$HAS_REAL" ]; then
        rm -rf docs/sprints/sprint-000_initial
        ok "    已删除废弃目录: docs/sprints/sprint-000_initial/（纯模板副本）"
      else
        mv docs/sprints/sprint-000_initial docs/sprints/sprint-000_initial.legacy
        warn "    sprint-000_initial 含真实内容 → 保留为 .legacy（AI 转移基线设计到 sp-001-*/docs/ 后删除）"
        LEGACY_NOTES+=("docs/sprints/sprint-000_initial.legacy → 基线设计转移至 sp-001-*/docs/ 后删除")
        REPORT_NEEDED=1
      fi
    fi

    # 旧模板可删，但 .legacy 必须保留给 AI 确认，禁止整体删除 docs/sprints/
    rm -rf docs/sprints/_template 2>/dev/null || true
    rmdir docs/sprints 2>/dev/null || true
  fi

  # ═══════════════════════════════════════════════
  # 2. 迁移历代 ADR 结构 → architecture/adrs/
  #    旧单文件可直接转移；v3.x 三文件夹完整保留为 .legacy，由 AI 提炼决策后删除
  # ═══════════════════════════════════════════════
  mkdir -p architecture/adrs
  if [ -d ADR ]; then
    info "② 检测到旧结构 ADR/，迁移到 architecture/adrs/ ..."
    for f in ADR/ADR-*.md; do
      [ -f "$f" ] || continue
      base=$(basename "$f")
      name=$(printf '%s' "$base" | sed 's/^ADR-//; s/\.md$//; s/_/-/g')
      target="architecture/adrs/adr-$(date +%Y%m%d)-$name.md"
      if [ ! -e "$target" ]; then
        mv "$f" "$target"
        ok "    已转移: $base → $target（历史架构决策）"
        LEGACY_NOTES+=("$target → AI 补齐背景/决策/影响/生效规格，并把当前有效结果收敛到 architecture/*.md")
        REPORT_NEEDED=1
      else
        warn "    $target 已存在，保留原文件并交由 AI 合并"
        LEGACY_NOTES+=("$f → $target 已存在，AI 对比合并后删除原文件")
        REPORT_NEEDED=1
      fi
    done
    while IFS= read -r f; do
      case "$f" in ADR/_template/*|ADR/ADR-*.md) continue;; esac
      LEGACY_NOTES+=("$f（ADR 内游离文档，AI 判断归属）")
      REPORT_NEEDED=1
    done < <(find ADR -type f -name "*.md" 2>/dev/null || true)
    if [ -d ADR/_template ]; then
      legacy="architecture/adrs/legacy-v2-template"
      if [ ! -e "$legacy" ]; then
        mv ADR/_template "$legacy"
        LEGACY_NOTES+=("$legacy/ → 核对是否含项目专属架构内容；无则删除")
        REPORT_NEEDED=1
      else
        LEGACY_NOTES+=("ADR/_template/ 与 $legacy/ 同时存在，AI 对比后保留项目专属内容")
        REPORT_NEEDED=1
      fi
    fi
    rmdir ADR 2>/dev/null || true
  fi

  # 2b. v3.x 根 adrs/adr-* 迁入 architecture/adrs/
  if [ -d adrs ]; then
    if [ -d adrs/_template ]; then
      legacy="architecture/adrs/legacy-v3-template"
      if [ ! -e "$legacy" ]; then
        mv adrs/_template "$legacy"
        LEGACY_NOTES+=("$legacy/ → 核对是否含项目专属架构内容；无则删除")
        REPORT_NEEDED=1
      else
        LEGACY_NOTES+=("adrs/_template/ 与 $legacy/ 同时存在，AI 对比后保留项目专属内容")
        REPORT_NEEDED=1
      fi
    fi
    while IFS= read -r f; do
      [ -f "$f" ] || continue
      base=$(basename "$f")
      name=$(printf '%s' "$base" | sed 's/^adr-//; s/\.md$//; s/_/-/g')
      target="architecture/adrs/adr-$name.md"
      if [ ! -e "$target" ]; then
        mv "$f" "$target"
        ok "    已转移: $f → $target"
        LEGACY_NOTES+=("$target → AI 收敛为单一架构决策，并同步当前 architecture/*.md")
        REPORT_NEEDED=1
      else
        LEGACY_NOTES+=("$f → $target 已存在，AI 对比合并")
        REPORT_NEEDED=1
      fi
    done < <(find adrs -maxdepth 1 -type f -name "*.md" 2>/dev/null || true)

    while IFS= read -r olddir; do
      [ -d "$olddir" ] || continue
      base=$(basename "$olddir")
      legacy="architecture/adrs/$base.legacy"
      if [ ! -e "$legacy" ]; then
        mv "$olddir" "$legacy"
        ok "    已保留: $olddir/ → $legacy/（v3.x 三文件架构快照）"
        LEGACY_NOTES+=("$legacy/ → AI 提炼为 architecture/adrs/$base.md，将最新有效结果合并到 architecture/*.md，确认无遗漏后删除 .legacy")
        REPORT_NEEDED=1
      else
        warn "    $legacy 已存在，保留 $olddir/ 待 AI 合并"
        LEGACY_NOTES+=("$olddir/ 与 $legacy/ 存在冲突，AI 对比合并")
        REPORT_NEEDED=1
      fi
    done < <(find adrs -mindepth 1 -maxdepth 1 -type d 2>/dev/null || true)
    rmdir adrs 2>/dev/null || true
  fi

  # ═══════════════════════════════════════════════
  # 3. 检测模块内 specs/（v2.x 模块维度规格）→ 报告 AI 迁移到迭代容器
  # ═══════════════════════════════════════════════
  MODULE_SPECS=()
  for dir in apps businesses tools; do
    [ -d "$dir" ] || continue
    while IFS= read -r sp; do
      MODULE_SPECS+=("$sp")
    done < <(find "$dir" -type d -name specs 2>/dev/null || true)
  done
  if [ ${#MODULE_SPECS[@]} -gt 0 ]; then
    warn "③ 检测到模块内 specs/（v2.x 结构）——需迁移到迭代容器 sprints/sp-NNN-*/specs/："
    for sp in "${MODULE_SPECS[@]}"; do
      echo "    - $sp/（AI 按 spec 头部「基于冲刺」字段归入对应冲刺，重新编号 spec-NNN-xxx）"
    done
    REPORT_NEEDED=1
  fi

  # 已有迭代规格需补齐 v4 架构落地边界；只报告，不自动猜测业务语义
  if [ -d sprints ]; then
    while IFS= read -r req; do
      if ! grep -q "架构落地边界" "$req" 2>/dev/null; then
        LEGACY_SPECS+=("$req")
        REPORT_NEEDED=1
      fi
    done < <(find sprints -path "*/specs/*/requirements.md" ! -path "*/_template/*" ! -path "*.legacy*" 2>/dev/null || true)
  fi

  # ═══════════════════════════════════════════════
  # 4. 根目录残留 ssot-convention（方法论本体，仅应存在于主仓库）
  # ═══════════════════════════════════════════════
  if ls ssot-convention*.md >/dev/null 2>&1; then
    mkdir -p archive
    for f in ssot-convention*.md; do
      mv "$f" "archive/$f"
      ok "    已归档: $f → archive/$f（方法论本体文档，最新版见 SpecRocket GitHub 主仓库）"
    done
  fi

  # ═══════════════════════════════════════════════
  # 4b. LICENSE 处理（v3.2 起模板不再预设证书）
  # ═══════════════════════════════════════════════
  if [ -f LICENSE ]; then
    if head -1 LICENSE | grep -q "^MIT License$" && grep -q "Toketec" LICENSE; then
      mkdir -p archive
      mv LICENSE archive/LICENSE
      ok "    已归档: LICENSE → archive/LICENSE（v3.2 起模板不再预设证书，旧模板默认 MIT 已移除，如需证书请自行添加）"
      REPORT_NEEDED=1
    else
      warn "    保留: LICENSE（项目自定义证书，v3.2 起模板不再预设证书，此证书由项目自行持有）"
    fi
  fi

  # ═══════════════════════════════════════════════
  # 5. 补齐新骨架（docs + architecture + 最新 sprint/spec 模板 + assets）
  # ═══════════════════════════════════════════════
  # docs/ 四件套
  mkdir -p docs
  for f in product-overview.md non-functional-reqs.md visual-design.md whitepaper.md; do
    if [ ! -f "docs/$f" ] && [ -f "$TEMPLATE/docs/$f" ]; then
      cp "$TEMPLATE/docs/$f" "docs/$f"
      ok "    补齐: docs/$f"
    fi
  done
  # architecture/ 当前架构三文件 + 单文件 ADR 模板
  mkdir -p architecture/adrs
  for f in architecture.md data-model.md runtime.md; do
    if [ ! -f "architecture/$f" ] && [ -f "$TEMPLATE/architecture/$f" ]; then
      cp "$TEMPLATE/architecture/$f" "architecture/$f"
      ok "    补齐: architecture/$f"
      LEGACY_NOTES+=("architecture/$f → AI 结合当前代码、旧 ADR 与部署配置收敛真实当前架构，不保留模板占位")
      REPORT_NEEDED=1
    fi
  done
  if [ ! -f architecture/adrs/_template.md ] && [ -f "$TEMPLATE/architecture/adrs/_template.md" ]; then
    cp "$TEMPLATE/architecture/adrs/_template.md" architecture/adrs/_template.md
    ok "    补齐: architecture/adrs/_template.md"
  fi
  # architecture/ 根目录只允许三份当前文档和 adrs/，不自动删除或猜测其他架构资料
  while IFS= read -r f; do
    ARCHITECTURE_STRAY+=("$f")
    REPORT_NEEDED=1
  done < <(find architecture -mindepth 1 -maxdepth 1 ! -name "architecture.md" ! -name "data-model.md" ! -name "runtime.md" ! -name "adrs" 2>/dev/null || true)
  # 已有 sprint 容器补齐 prototypes.md（UI 设计文档，v3.2.1）
  if [ -d sprints ]; then
    while IFS= read -r pd; do
      if [ ! -f "$pd/prototypes.md" ] && [ -f "$TEMPLATE/sprints/_template/docs/prototypes/prototypes.md" ]; then
        cp "$TEMPLATE/sprints/_template/docs/prototypes/prototypes.md" "$pd/prototypes.md"
        ok "    补齐: $pd/prototypes.md（UI 设计文档）"
      fi
    done < <(find sprints -maxdepth 5 -type d -name prototypes 2>/dev/null || true)
  fi
  # sprints/_template/ 是框架模板，升级时保留旧副本并安装最新版，避免旧项目继续生成过时 spec
  if [ -d "$TEMPLATE/sprints/_template" ]; then
    mkdir -p sprints
    if [ ! -d sprints/_template ]; then
      cp -r "$TEMPLATE/sprints/_template" sprints/_template
      ok "    补齐: sprints/_template/（docs/ + specs/ 模板）"
    elif ! diff -qr sprints/_template "$TEMPLATE/sprints/_template" >/dev/null 2>&1; then
      if [ ! -e sprints/_template.legacy-v3 ]; then
        mv sprints/_template sprints/_template.legacy-v3
        cp -r "$TEMPLATE/sprints/_template" sprints/_template
        ok "    已升级: sprints/_template/（旧模板保留为 _template.legacy-v3）"
        LEGACY_NOTES+=("sprints/_template.legacy-v3/ → AI 确认无项目专属模板内容遗漏后删除")
        REPORT_NEEDED=1
      else
        warn "    sprints/_template/ 与最新模板不一致，且 _template.legacy-v3 已存在，请 AI 合并"
        REPORT_NEEDED=1
      fi
    fi
  fi
  # 旧项目 AGENTS.md 可含项目专属规则，不覆盖；报告 AI 合并 v4 方法论入口
  if [ ! -f AGENTS.md ] && [ -f "$TEMPLATE/AGENTS.md" ]; then
    cp "$TEMPLATE/AGENTS.md" AGENTS.md
    ok "    补齐: AGENTS.md"
  elif [ -f AGENTS.md ] && ! grep -q "architecture/runtime.md" AGENTS.md 2>/dev/null; then
    LEGACY_NOTES+=("AGENTS.md → 保留项目专属规则，AI 按最新 template/AGENTS.md 合并 architecture/ + 阶段规格规则")
    REPORT_NEEDED=1
  fi
  # assets/ 骨架（v2.9 沿用）
  if [ ! -d assets ]; then
    if [ -d "$TEMPLATE/assets" ]; then
      cp -r "$TEMPLATE/assets" assets
      ok "    补齐: assets/ 运营资产骨架（configs/interfaces/standards/manuals）"
    fi
  else
    for sub in configs interfaces standards manuals; do
      if [ ! -d "assets/$sub" ]; then
        mkdir -p "assets/$sub"
        ok "    补齐: assets/$sub/"
      fi
    done
    [ ! -f assets/README.md ] && [ -f "$TEMPLATE/assets/README.md" ] && cp "$TEMPLATE/assets/README.md" assets/README.md
    while IFS= read -r f; do
      base=$(basename "$f")
      [ "$base" = "README.md" ] && continue
      ASSETS_STRAY+=("$f")
    done < <(find assets -maxdepth 1 -mindepth 1 ! -name "configs" ! -name "interfaces" ! -name "standards" ! -name "manuals" 2>/dev/null || true)
  fi
  # 运营资产目录自动归位（规则2）
  move_ops_dir() { # $1=源目录 $2=目标子目录
    local src="$1" dst="assets/$2"
    [ -d "$src" ] || return 0
    if [ ! -d "$dst" ]; then
      mv "$src" "$dst"
      ok "    已转移: $src/ → $dst/（规则2：运营资产收敛 assets/）"
      REPORT_NEEDED=1
    elif [ -z "$(ls -A "$dst" | grep -v '^\.gitkeep$' 2>/dev/null)" ]; then
      mv "$src"/* "$dst"/ 2>/dev/null || true
      rmdir "$src" 2>/dev/null || true
      ok "    已转移: $src/ → $dst/（合并入骨架）"
      REPORT_NEEDED=1
    else
      warn "    $src/ → $dst/（目标已存在，内容请 AI 合并）"
      REPORT_NEEDED=1
    fi
  }
  move_ops_dir config configs
  move_ops_dir api interfaces
  move_ops_dir manual manuals
  move_ops_dir docs-manual manuals
  move_ops_dir standards standards

  # ═══════════════════════════════════════════════
  # 6. 游离文档扫描（规则1：收敛 docs/；规则2：归位 assets/）
  # ═══════════════════════════════════════════════
  if [ -d docs ]; then
    while IFS= read -r f; do
      base=$(basename "$f")
      case "$base" in
        product-overview.md|non-functional-reqs.md|visual-design.md|whitepaper.md|README.md|preview.html) continue ;;
        *.legacy.md) continue ;;
      esac
      STRAY_DOCS+=("$f")
    done < <(find docs -type f \( -name "*.md" -o -name "*.html" \) 2>/dev/null || true)
  fi
  while IFS= read -r f; do
    base=$(basename "$f")
    case "$base" in
      AGENTS.md|CLAUDE.md|README.md|README.en.md|MIGRATION-REPORT.md|ssot-convention*.md|LICENSE) continue ;;
      *.legacy.md) continue ;;
    esac
    case "$base" in
      *.md|*.txt|*.docx|*.doc|*.pdf|*.rst|*.tex) ROOT_STRAY_R1+=("$f") ;;
      *) ROOT_STRAY_R2+=("$f") ;;
    esac
  done < <(find . -maxdepth 1 -type f ! -name ".*" 2>/dev/null || true)
  while IFS= read -r d; do
    base=$(basename "$d")
    case "$base" in
      docs|architecture|sprints|apps|businesses|tools|assets|archive) continue ;;
      .*) continue ;;
    esac
    ROOT_STRAY_R2+=("$d")
  done < <(find . -maxdepth 1 -type d ! -name "." 2>/dev/null || true)

  # ═══════════════════════════════════════════════
  # 6b. visual-design 混入业务设计扫描（v3.2.1）
  # ═══════════════════════════════════════════════
  VD_SCAN=0
  VD_HITS=""
  if [ -f docs/visual-design.md ]; then
    VD_HITS=$(grep -nE "首页|列表页|详情页|登录页|注册页|购物车|导航栏|线框|框线图|页面结构|业务字段" docs/visual-design.md 2>/dev/null | grep -vE ":[|>]" | head -10 || true)
    if [ -n "$VD_HITS" ]; then
      VD_SCAN=1
      REPORT_NEEDED=1
    fi
  fi

  # 架构迁移不能只生成摘要：登记所有历史决策/旧快照，强制 AI 逐项判断当前性并映射到当前架构章节。
  if [ -d architecture/adrs ]; then
    while IFS= read -r f; do
      ARCHITECTURE_SOURCES+=("$f")
    done < <(find architecture/adrs -mindepth 1 -maxdepth 1 -type f -name "adr-*.md" ! -name "_template.md" 2>/dev/null | sort || true)
    while IFS= read -r d; do
      ARCHITECTURE_SOURCES+=("$d/")
    done < <(find architecture/adrs -mindepth 1 -maxdepth 1 -type d \( -name "*.legacy" -o -name "legacy-*" \) 2>/dev/null | sort || true)
  fi

  # ═══════════════════════════════════════════════
  # 7. 报告输出
  # ═══════════════════════════════════════════════
  if [ "${#LEGACY_NOTES[@]}" -gt 0 ]; then
    warn "检测到旧版结构，已完成结构层迁移（详见下方报告）："
    for n in "${LEGACY_NOTES[@]}"; do
      echo "    - $n"
    done
  fi
  if [ "${#STRAY_DOCS[@]}" -gt 0 ] || [ "${#ROOT_STRAY_R1[@]}" -gt 0 ]; then
    warn "检测到不符合模板的游离内容文档（规则1：优先收敛到 docs/ 对应文档，由 AI 判断归属并合并）："
    for f in "${STRAY_DOCS[@]}" "${ROOT_STRAY_R1[@]}"; do
      echo "    - $f"
    done
    REPORT_NEEDED=1
  fi
  if [ "${#ROOT_STRAY_R2[@]}" -gt 0 ]; then
    warn "检测到根目录非规范项（规则2：转移并收敛到 assets/ 对应子目录，由 AI 确认归属）："
    for f in "${ROOT_STRAY_R2[@]}"; do
      echo "    - $f"
    done
    REPORT_NEEDED=1
  fi
  if [ "$VD_SCAN" = "1" ]; then
    warn "docs/visual-design.md 疑似混入业务设计（关键词命中；含模板示例词的行可忽略，请 AI 判断）："
    echo "$VD_HITS" | sed 's/^/    /'
    echo "    → 确为业务设计时：转移到 sprints/*/docs/prototypes/prototypes.md，visual-design.md 只留审美边界"
  fi
  if [ "${#ASSETS_STRAY[@]}" -gt 0 ]; then
    warn "检测到 assets/ 内散落项（规则2：归位到 configs/interfaces/standards/manuals）："
    for f in "${ASSETS_STRAY[@]}"; do
      echo "    - $f"
    done
    REPORT_NEEDED=1
  fi
  if [ "${#ARCHITECTURE_STRAY[@]}" -gt 0 ]; then
    warn "architecture/ 根目录只允许三份当前架构文档，以下内容需由 AI 收敛后移出（禁止新增 README）："
    for f in "${ARCHITECTURE_STRAY[@]}"; do
      echo "    - $f"
    done
  fi
  if [ "${#MODULE_SPECS[@]}" -gt 0 ]; then
    REPORT_NEEDED=1
  fi
  if [ "${#LEGACY_SPECS[@]}" -gt 0 ]; then
    warn "检测到旧规格缺少架构落地边界，由 AI 逐个补齐，禁止脚本猜测语义："
    for req in "${LEGACY_SPECS[@]}"; do
      echo "    - $req"
    done
  fi

  # 生成 MIGRATION-REPORT.md
  if [ "$REPORT_NEEDED" = "1" ] || [ ${#LEGACY_NOTES[@]} -gt 0 ]; then
    REPORT="MIGRATION-REPORT.md"
    {
      echo "# 迁移报告 — $(date +%Y-%m-%d)"
      echo ""
      echo "> 由 /spec-rocket migrate v$VERSION 生成。重构原则：**转移 → 收敛 → 保留 → 删除**。"
      echo "> 请由 AI 按 SKILL.md 流程处理：②理解项目 → ③保持原有设计 → ④重构 → ⑤验收，完成后目录结构完全符合最新规范，零残留。"
      echo "> **阻断规则**：三份当前架构必须能脱离 ADR 独立说明系统；下方证据矩阵或协作边界矩阵存在空项，共享边界缺少生产方、消费方、权威契约或兼容策略，或任一当前有效规则仍只能从 ADR 得知时，不得删除本报告。"
      echo ""
      echo "## 迁移映射表（旧 → 新）"
      echo ""
      echo "| 旧结构 | 新位置 | 策略 |"
      echo "|:--|:--|:--|"
      echo "| \`docs/sprints/sprint-NNN_xxx/\` 文档 | \`sprints/sp-NNN-xxx/docs/\` | 转移（脚本已执行，.legacy 待删） |"
      echo "| \`{apps|businesses|tools}/*/specs/SPEC-{APP|BIZ|TOOL}-NNN_xxx/\` | \`sprints/sp-NNN-xxx/specs/spec-NNN-xxx/\` | AI 按「基于冲刺」字段归入，重新编号 |"
      echo "| \`ADR/ADR-NNN_xxx.md\` | \`architecture/adrs/adr-YYYYMMDD-xxx.md\` | 转移为单文件历史决策，AI 补齐决策语义 |"
      echo "| \`adrs/adr-*/\` 三文件快照 | \`architecture/adrs/adr-*.legacy/\` | 完整保留，AI 提炼单文件 ADR 并收敛当前架构 |"
      echo "| 旧 spec \`requirements.md\` | 原规格内补齐架构基线/进入/实现程度/退出/临时边界 | AI 依据现有代码与规格语义补齐 |"
      echo "| \`ux-flows.md\` | 旅程 → \`user-scenarios.md\`；流程 → \`business-flows.md\` | AI 转移 |"
      echo "| \`ui-wireframes.md\` | 布局/交互 → \`prototypes/\`；系统图表 → \`uml-pack.md\` | AI 转移 |"
      echo "| \`user-journey-flows.md\` | 旅程总览 → \`user-scenarios.md\`；流程图 → \`business-flows.md\` | AI 转移 |"
      echo ""
      echo "## 当前架构收敛证据矩阵（必须逐项填写）"
      echo ""
      echo "> 当前性只能填写：当前有效 / 纯历史 / 混合。当前有效或混合必须写明目标文档及具体章节；纯历史必须写明失效或替代依据。禁止只填写‘已处理’。"
      echo ""
      echo "| 来源 | 当前性 | 当前事实写入的目标章节 | 历史决策/冲突处理结论 |"
      echo "|:-----|:-------|:-----------------------|:-----------------------|"
      if [ ${#ARCHITECTURE_SOURCES[@]} -gt 0 ]; then
        for source in "${ARCHITECTURE_SOURCES[@]}"; do
          printf '| `%s` | 待填写 | 待填写 | 待填写 |\n' "$source"
        done
      else
        echo "| 现有代码、数据迁移与部署配置 | 待填写 | 待填写 | 无旧 ADR 时仍需从当前实现重建架构 |"
      fi
      echo "| 当前代码与模块入口 | 当前有效 | 待填写 | 记录与旧 ADR 不一致处及采用依据 |"
      echo "| 数据 migration/schema | 待判断 | 待填写 | 无持久化时标记不适用；有持久化时记录所属服务、当前 schema/migration 与语义映射 |"
      echo "| 部署编排、CI 与配置模板 | 当前有效 | 待填写 | 记录运行单元、依赖、健康、故障与恢复证据 |"
      echo "| 公共契约与外部端口 | 待判断 | 待填写 | 无共享边界时标记不适用；有共享边界时进入下方契约重建矩阵 |"
      echo ""
      echo "## 共享协作边界与契约重建矩阵（逐项判断）"
      echo ""
      echo "> 根据当前代码、部署单元、调用链、消息/文件和外部消费者判断。无共享边界明确写‘不适用’，不得伪造契约；存在共享边界时逐项填写，不能仅凭接口文件或目录存在判断契约有效。"
      echo ""
      echo "| 协作边界 | 生产方 | 消费方/外部用户 | 当前权威定义 | 兼容策略 | Mock/生成物同步 | 验证方式 | 负责 spec | 结论 |"
      echo "|:---------|:-------|:----------------|:-------------|:---------|:----------------|:---------|:----------|:-----|"
      echo "| 待判断 | 待填写 | 待填写 | 待填写 | 待填写 | 待填写 | 待填写 | 待填写 | 待填写 |"
      echo ""
      echo "> 契约/模型检查、生成、Mock 或可视化工具不是迁移默认产物。AI 只说明价值、成本和适用边界；用户决定建设后，在 \`tools/\` 中另建正常 spec 推进。"
      echo ""
      echo "### 架构独立阅读门禁"
      echo ""
      echo "完成迁移前，由不打开 \`architecture/adrs/\` 的读者仅阅读三份当前架构，并逐项回答："
      echo ""
      echo "- [ ] 系统负责什么、不负责什么，模块和信任边界如何划分？"
      echo "- [ ] 核心业务/技术链路如何流转，成功、失败、重试和人工处置在哪里发生？"
      echo "- [ ] 数据事实源、聚合关系、可变/不可变分层、状态转换和一致性规则是什么？"
      echo "- [ ] 系统由哪些运行单元和故障域组成，如何配置、判活、扩缩、备份和恢复？"
      echo "- [ ] 每项当前有效/混合来源都已映射到具体章节，没有当前规则只留在 ADR？"
      echo ""
      echo "## 待 AI 处理项"
      echo ""
      if [ ${#LEGACY_NOTES[@]} -gt 0 ]; then
        echo "### 已转移待确认（内容已复制，确认后删除原件）"
        echo ""
        for n in "${LEGACY_NOTES[@]}"; do
          echo "- $n"
        done
        echo ""
      fi
      if [ ${#MODULE_SPECS[@]} -gt 0 ]; then
        echo "### 模块内 specs/（需迁移到迭代容器）"
        echo ""
        for sp in "${MODULE_SPECS[@]}"; do
          echo "- $sp/"
        done
        echo ""
      fi
      if [ ${#LEGACY_SPECS[@]} -gt 0 ]; then
        echo "### 旧规格阶段语义补齐"
        echo ""
        echo "> 逐个核对当时代码、上下游规格与验收记录，补齐架构基线、进入状态、实现程度、退出状态、临时实现和收口规格。已完成规格只补齐事实，不借迁移改写历史交付边界。"
        echo ""
        for req in "${LEGACY_SPECS[@]}"; do
          echo "- $req"
        done
        echo ""
      fi
      if [ "$VD_SCAN" = "1" ]; then
        echo "### visual-design.md 疑似业务设计（AI 判断后转移到 prototypes.md）"
        echo ""
        echo "$VD_HITS" | sed 's/^/- /'
        echo ""
      fi
      if [ "${#STRAY_DOCS[@]}" -gt 0 ] || [ "${#ROOT_STRAY_R1[@]}" -gt 0 ]; then
        echo "### 游离内容文档（规则1，AI 收敛到 docs/ 对应文档）"
        echo ""
        for f in "${STRAY_DOCS[@]}" "${ROOT_STRAY_R1[@]}"; do
          echo "- $f"
        done
        echo ""
      fi
      if [ "${#ROOT_STRAY_R2[@]}" -gt 0 ]; then
        echo "### 根目录非规范项（规则2，AI 归位 assets/）"
        echo ""
        for f in "${ROOT_STRAY_R2[@]}"; do
          echo "- $f"
        done
        echo ""
      fi
      if [ "${#ASSETS_STRAY[@]}" -gt 0 ]; then
        echo "### assets/ 待归位（规则2）"
        echo ""
        for f in "${ASSETS_STRAY[@]}"; do
          echo "- $f"
        done
        echo ""
      fi
      if [ "${#ARCHITECTURE_STRAY[@]}" -gt 0 ]; then
        echo "### architecture/ 根目录待收敛项"
        echo ""
        echo "> 当前架构根目录只保留 architecture.md、data-model.md、runtime.md，不建立 README。将当前有效事实合并到三份文档；历史决策进入 architecture/adrs/；操作手册或配置进入 assets/。"
        echo ""
        for f in "${ARCHITECTURE_STRAY[@]}"; do
          echo "- $f"
        done
        echo ""
      fi
    } > "$REPORT"
    ok "已生成迁移报告: $REPORT（AI 处理完成后删除本文件）"
  fi

  echo ""
  info "migrate v$VERSION 介入完成（结构层）。"
  if [ "$REPORT_NEEDED" = "1" ]; then
    echo "  1. AI 读取 MIGRATION-REPORT.md 并先理解项目（②理解）"
    echo "  2. 逐项填写架构证据矩阵和协作边界矩阵，再按映射表保持原有设计并转移（③保持）"
    echo "  3. 三份当前架构、契约与数据门禁通过后，才删除报告与所有 .legacy 保留项"
  else
    echo "  项目结构已是最新。AI 仍须按 SKILL.md 审计协作边界、契约和数据基线；无共享边界或持久化时明确不适用。"
  fi
}

# ============================================================
# main
# ============================================================
case "${1:-help}" in
  init)    shift; cmd_init "$@" ;;
  update)  shift; cmd_update "$@" ;;
  migrate) shift; cmd_migrate "$@" ;;
  help|-h|--help|"")
    echo "SpecRocket CLI v$VERSION"
    echo "Usage:"
    echo "  ./spec-rocket init [项目名]    # 初始化新项目（无参=当前目录）"
    echo "  ./spec-rocket update          # 一键更新本地 skill（自动检测 AI 工具）"
    echo "  ./spec-rocket migrate [路径]   # 项目重构（介入 → 理解 → 保持 → 重构，零残留）"
    ;;
  *)
    err "未知命令: $1（可用: init / update / migrate / help）"
    exit 1
    ;;
esac
